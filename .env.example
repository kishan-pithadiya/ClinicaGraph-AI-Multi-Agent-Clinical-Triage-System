# ==============================================
# ClinicaGraph AI - Environment Configuration
# ==============================================

# Provider: 'openai', 'azure', or 'mock' (offline demo)
LLM_PROVIDER=openai

# Direct OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI Configuration (if using Azure)
deployment_name=gpt-4o
model_name=gpt-4o
azure_endpoint=https://your-resource.openai.azure.com/
openai_api_key=your_azure_api_key_here
openai_api_version=2024-02-15-preview

embedding_deployment_name=text-embedding-3-small
embedding_model_name=text-embedding-3-small
embedding_azure_endpoint=https://your-resource.openai.azure.com/
embedding_openai_api_key=your_azure_api_key_here
embedding_openai_api_version=2024-02-15-preview

# Real-Time Search & Web Research (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

# Speech-to-Text & Text-to-Speech (Optional)
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Qdrant Vector Database
QDRANT_USE_LOCAL=true
QDRANT_LOCAL_PATH=./data/qdrant_db
QDRANT_COLLECTION=clinicagraph_clinical_rag

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
